// -----------------------------------------------------------------
// 2. Core Validation Utilities
// -----------------------------------------------------------------
const ETValidator = {
    // Utility helpers
    get: function (idOrElem) {
        if (!idOrElem) return null;
        if (typeof idOrElem === 'string') {
            return document.getElementById(idOrElem) || document.querySelector('[id$="' + idOrElem + '"]');
        }
        return idOrElem;
    },

    val: function (idOrElem) {
        var el = this.get(idOrElem);
        return el ? (el.value || '').trim() : '';
    },

    isEmpty: function (val) {
        return !val || val.trim().length === 0;
    },

    isValidEmail: function (email) {
        if (!email) return false;
        var emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
        return emailPattern.test(email.trim());
    },

    isNumber: function (val) {
        if (this.isEmpty(val)) return false;
        var n = Number(val);
        return !isNaN(n) && isFinite(n);
    },

    isPositiveNumber: function (val) {
        if (!this.isNumber(val)) return false;
        return Number(val) > 0;
    },

    isMinLength: function (val, minLen) {
        return !!val && val.length >= minLen;
    },

    isValidPhone: function (phone) {
        if (this.isEmpty(phone)) return true; // Optional if empty
        var cleaned = phone.replace(/[\s\-\+\(\)]/g, '');
        return cleaned.length >= 7 && /^\d+$/.test(cleaned);
    },

    // -------------------------------------------------------------
    // UI Feedback & Alerts
    // -------------------------------------------------------------
    markError: function (idOrElem) {
        var el = this.get(idOrElem);
        if (!el) return;

        // If wrapped in an input-group, highlight the group
        var parentGroup = el.closest('.input-group') || el;
        parentGroup.classList.add('field-has-error');

        // Automatically clear error styling on user input
        var clearHandler = function () {
            parentGroup.classList.remove('field-has-error');
            el.removeEventListener('input', clearHandler);
            el.removeEventListener('change', clearHandler);
        };
        el.addEventListener('input', clearHandler);
        el.addEventListener('change', clearHandler);
    },

    clearAllErrors: function () {
        document.querySelectorAll('.field-has-error').forEach(function (el) {
            el.classList.remove('field-has-error');
        });
    },

    showToast: function (message, type) {
        type = type || 'error';
        var container = document.querySelector('.et-toast-container');
        if (!container) {
            container = document.createElement('div');
            container.className = 'et-toast-container';
            document.body.appendChild(container);
        }

        var toast = document.createElement('div');
        toast.className = 'et-toast et-toast-' + type;

        var iconSvg = type === 'success'
            ? '<svg class="et-toast-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>'
            : '<svg class="et-toast-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>';

        toast.innerHTML = iconSvg +
            '<span class="et-toast-msg">' + message + '</span>' +
            '<button type="button" class="et-toast-close" aria-label="Close">&times;</button>';

        container.appendChild(toast);

        // Animate in
        requestAnimationFrame(function () {
            toast.classList.add('visible');
        });

        // Close button handler
        var closeBtn = toast.querySelector('.et-toast-close');
        var removeToast = function () {
            toast.classList.remove('visible');
            setTimeout(function () {
                if (toast.parentNode) toast.parentNode.removeChild(toast);
            }, 300);
        };
        if (closeBtn) closeBtn.onclick = removeToast;

        // Auto dismiss after 4 seconds
        setTimeout(removeToast, 4000);
    },

    setAlertMessage: function (labelId, message, isSuccess) {
        var lbl = this.get(labelId);
        if (lbl) {
            lbl.textContent = message;
            lbl.style.display = 'block';
            lbl.className = 'auth-alert visible ' + (isSuccess ? 'success' : 'error');
        }
        // Always trigger toast as well for immediate UX visibility
        this.showToast(message, isSuccess ? 'success' : 'error');
    }
};

// -----------------------------------------------------------------
// 3. Page & Form Specific Validation Functions
// -----------------------------------------------------------------

/**
 * Validates Login Form (Email & Password)
 */
function validateLoginForm() {
    ETValidator.clearAllErrors();

    var email = ETValidator.val('txtEmail');
    var password = ETValidator.val('txtPassword');

    if (ETValidator.isEmpty(email)) {
        ETValidator.markError('txtEmail');
        ETValidator.setAlertMessage('lblMessage', 'Please enter your email address.', false);
        var el = ETValidator.get('txtEmail');
        if (el) el.focus();
        return false;
    }

    if (!ETValidator.isValidEmail(email)) {
        ETValidator.markError('txtEmail');
        ETValidator.setAlertMessage('lblMessage', 'Please enter a valid email address (e.g. name@domain.com).', false);
        var el = ETValidator.get('txtEmail');
        if (el) el.focus();
        return false;
    }

    if (ETValidator.isEmpty(password)) {
        ETValidator.markError('txtPassword');
        ETValidator.setAlertMessage('lblMessage', 'Please enter your password.', false);
        var el = ETValidator.get('txtPassword');
        if (el) el.focus();
        return false;
    }

    return true;
}

/**
 * Validates Register Form (Full Name, Email, Password, Confirm Password)
 */
function validateRegisterForm() {
    ETValidator.clearAllErrors();

    var fullName = ETValidator.val('txtFullName');
    var email = ETValidator.val('txtEmail');
    var password = ETValidator.val('txtPassword');
    var confirmPassword = ETValidator.val('txtConfirmPassword');

    if (ETValidator.isEmpty(fullName)) {
        ETValidator.markError('txtFullName');
        ETValidator.setAlertMessage('lblMessage', 'Please enter your full name.', false);
        var el = ETValidator.get('txtFullName');
        if (el) el.focus();
        return false;
    }

    if (fullName.length < 2) {
        ETValidator.markError('txtFullName');
        ETValidator.setAlertMessage('lblMessage', 'Full name must be at least 2 characters.', false);
        var el = ETValidator.get('txtFullName');
        if (el) el.focus();
        return false;
    }

    if (ETValidator.isEmpty(email)) {
        ETValidator.markError('txtEmail');
        ETValidator.setAlertMessage('lblMessage', 'Please enter your email address.', false);
        var el = ETValidator.get('txtEmail');
        if (el) el.focus();
        return false;
    }

    if (!ETValidator.isValidEmail(email)) {
        ETValidator.markError('txtEmail');
        ETValidator.setAlertMessage('lblMessage', 'Please enter a valid email address.', false);
        var el = ETValidator.get('txtEmail');
        if (el) el.focus();
        return false;
    }

    if (ETValidator.isEmpty(password)) {
        ETValidator.markError('txtPassword');
        ETValidator.setAlertMessage('lblMessage', 'Please create a password.', false);
        var el = ETValidator.get('txtPassword');
        if (el) el.focus();
        return false;
    }

    if (password.length < 6) {
        ETValidator.markError('txtPassword');
        ETValidator.setAlertMessage('lblMessage', 'Password must be at least 6 characters long.', false);
        var el = ETValidator.get('txtPassword');
        if (el) el.focus();
        return false;
    }

    if (ETValidator.isEmpty(confirmPassword)) {
        ETValidator.markError('txtConfirmPassword');
        ETValidator.setAlertMessage('lblMessage', 'Please confirm your password.', false);
        var el = ETValidator.get('txtConfirmPassword');
        if (el) el.focus();
        return false;
    }

    if (password !== confirmPassword) {
        ETValidator.markError('txtPassword');
        ETValidator.markError('txtConfirmPassword');
        ETValidator.setAlertMessage('lblMessage', 'Passwords do not match. Please verify.', false);
        var el = ETValidator.get('txtConfirmPassword');
        if (el) el.focus();
        return false;
    }

    return true;
}

/**
 * Validates Profile Details (Full Name, Email, Phone)
 */
function validateProfileForm() {
    ETValidator.clearAllErrors();

    var fullName = ETValidator.val('txtFullName');
    var email = ETValidator.val('txtEmail');
    var phone = ETValidator.val('txtPhone');

    if (ETValidator.isEmpty(fullName)) {
        ETValidator.markError('txtFullName');
        ETValidator.setAlertMessage('lblProfileMessage', 'Full name is required.', false);
        var el = ETValidator.get('txtFullName');
        if (el) el.focus();
        return false;
    }

    if (ETValidator.isEmpty(email)) {
        ETValidator.markError('txtEmail');
        ETValidator.setAlertMessage('lblProfileMessage', 'Email address is required.', false);
        var el = ETValidator.get('txtEmail');
        if (el) el.focus();
        return false;
    }

    if (!ETValidator.isValidEmail(email)) {
        ETValidator.markError('txtEmail');
        ETValidator.setAlertMessage('lblProfileMessage', 'Please enter a valid email address.', false);
        var el = ETValidator.get('txtEmail');
        if (el) el.focus();
        return false;
    }

    if (!ETValidator.isEmpty(phone) && !ETValidator.isValidPhone(phone)) {
        ETValidator.markError('txtPhone');
        ETValidator.setAlertMessage('lblProfileMessage', 'Please enter a valid phone number.', false);
        var el = ETValidator.get('txtPhone');
        if (el) el.focus();
        return false;
    }

    return true;
}

/**
 * Validates Password Change Form
 */
function validateChangePasswordForm() {
    ETValidator.clearAllErrors();

    var currentPass = ETValidator.val('txtCurrentPassword');
    var newPass = ETValidator.val('txtNewPassword');
    var confirmPass = ETValidator.val('txtConfirmNewPassword');

    if (ETValidator.isEmpty(currentPass)) {
        ETValidator.markError('txtCurrentPassword');
        ETValidator.setAlertMessage('lblPasswordMessage', 'Please enter your current password.', false);
        var el = ETValidator.get('txtCurrentPassword');
        if (el) el.focus();
        return false;
    }

    if (ETValidator.isEmpty(newPass)) {
        ETValidator.markError('txtNewPassword');
        ETValidator.setAlertMessage('lblPasswordMessage', 'Please enter a new password.', false);
        var el = ETValidator.get('txtNewPassword');
        if (el) el.focus();
        return false;
    }

    if (newPass.length < 6) {
        ETValidator.markError('txtNewPassword');
        ETValidator.setAlertMessage('lblPasswordMessage', 'New password must be at least 6 characters.', false);
        var el = ETValidator.get('txtNewPassword');
        if (el) el.focus();
        return false;
    }

    if (currentPass === newPass) {
        ETValidator.markError('txtNewPassword');
        ETValidator.setAlertMessage('lblPasswordMessage', 'New password cannot be the same as the current password.', false);
        var el = ETValidator.get('txtNewPassword');
        if (el) el.focus();
        return false;
    }

    if (ETValidator.isEmpty(confirmPass)) {
        ETValidator.markError('txtConfirmNewPassword');
        ETValidator.setAlertMessage('lblPasswordMessage', 'Please repeat the new password in Confirm Password.', false);
        var el = ETValidator.get('txtConfirmNewPassword');
        if (el) el.focus();
        return false;
    }

    if (newPass !== confirmPass) {
        ETValidator.markError('txtNewPassword');
        ETValidator.markError('txtConfirmNewPassword');
        ETValidator.setAlertMessage('lblPasswordMessage', 'New passwords do not match.', false);
        var el = ETValidator.get('txtConfirmNewPassword');
        if (el) el.focus();
        return false;
    }

    return true;
}

/**
 * Validates Log Expense Form
 */
function validateExpenseForm() {
    ETValidator.clearAllErrors();

    var title = ETValidator.val('txtExpenseTitle');
    var amount = ETValidator.val('txtExpenseAmount');
    var date = ETValidator.val('txtExpenseDate');

    if (ETValidator.isEmpty(title)) {
        ETValidator.markError('txtExpenseTitle');
        ETValidator.showToast('Please enter an expense title.', 'error');
        var el = ETValidator.get('txtExpenseTitle');
        if (el) el.focus();
        return false;
    }

    if (ETValidator.isEmpty(amount) || !ETValidator.isPositiveNumber(amount)) {
        ETValidator.markError('txtExpenseAmount');
        ETValidator.showToast('Please enter a valid expense amount greater than 0.', 'error');
        var el = ETValidator.get('txtExpenseAmount');
        if (el) el.focus();
        return false;
    }

    if (ETValidator.isEmpty(date)) {
        ETValidator.markError('txtExpenseDate');
        ETValidator.showToast('Please select a date for this expense.', 'error');
        var el = ETValidator.get('txtExpenseDate');
        if (el) el.focus();
        return false;
    }

    return true;
}

/**
 * Validates Add Income Form
 */
function validateIncomeForm() {
    ETValidator.clearAllErrors();

    var source = ETValidator.val('txtIncomeSource');
    var amount = ETValidator.val('txtIncomeAmount');
    var date = ETValidator.val('txtIncomeDate');

    if (ETValidator.isEmpty(source)) {
        ETValidator.markError('txtIncomeSource');
        ETValidator.showToast('Please enter the income source/title.', 'error');
        var el = ETValidator.get('txtIncomeSource');
        if (el) el.focus();
        return false;
    }

    if (ETValidator.isEmpty(amount) || !ETValidator.isPositiveNumber(amount)) {
        ETValidator.markError('txtIncomeAmount');
        ETValidator.showToast('Please enter a valid income amount greater than 0.', 'error');
        var el = ETValidator.get('txtIncomeAmount');
        if (el) el.focus();
        return false;
    }

    if (ETValidator.isEmpty(date)) {
        ETValidator.markError('txtIncomeDate');
        ETValidator.showToast('Please select a date for this income.', 'error');
        var el = ETValidator.get('txtIncomeDate');
        if (el) el.focus();
        return false;
    }

    return true;
}

