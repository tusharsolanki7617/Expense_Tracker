/**
 * ====================================================================
 * Expense Tracker - Client-side Form Validation Library
 * File: Scripts/validation.js
 * Description: Modular, reusable client-side validation rules and UI
 * feedback for all forms in the Expense Tracker application.
 * ====================================================================
 */

(function () {
    // -------------------------------------------------------------
