    var dueDate = ETValidator.val('txtBillDueDate');

    if (ETValidator.isEmpty(name)) {
        ETValidator.markError('txtBillName');
        ETValidator.showToast('Please enter the bill name (e.g. Electricity, Rent).', 'error');
        var el = ETValidator.get('txtBillName');
        if (el) el.focus();
        return false;
    }

    if (ETValidator.isEmpty(amount) || !ETValidator.isPositiveNumber(amount)) {
        ETValidator.markError('txtBillAmount');
        ETValidator.showToast('Please enter a valid bill amount greater than 0.', 'error');
        var el = ETValidator.get('txtBillAmount');
        if (el) el.focus();
        return false;
    }

    if (ETValidator.isEmpty(dueDate)) {
        ETValidator.markError('txtBillDueDate');
        ETValidator.showToast('Please select the due date for this bill.', 'error');
        var el = ETValidator.get('txtBillDueDate');
        if (el) el.focus();
        return false;
    }

    return true;
}

/**
 * Validates Subscriptions Form
 */
function validateSubscriptionForm() {
    ETValidator.clearAllErrors();

    var name = ETValidator.val('txtSubName');
    var amount = ETValidator.val('txtSubAmount');
    var dueDate = ETValidator.val('txtSubDueDate');

    if (ETValidator.isEmpty(name)) {
        ETValidator.markError('txtSubName');
        ETValidator.showToast('Please enter the subscription name (e.g. Netflix, Spotify).', 'error');
        var el = ETValidator.get('txtSubName');
        if (el) el.focus();
        return false;
    }

    if (ETValidator.isEmpty(amount) || !ETValidator.isPositiveNumber(amount)) {
        ETValidator.markError('txtSubAmount');
        ETValidator.showToast('Please enter a valid monthly amount greater than 0.', 'error');
        var el = ETValidator.get('txtSubAmount');
        if (el) el.focus();
        return false;
    }

    if (ETValidator.isEmpty(dueDate)) {
        ETValidator.markError('txtSubDueDate');
        ETValidator.showToast('Please select the next billing date.', 'error');
        var el = ETValidator.get('txtSubDueDate');
        if (el) el.focus();
        return false;
    }

    return true;
}

/**
 * Validates Loan Form
 */
function validateLoanForm() {
    ETValidator.clearAllErrors();

    var person = ETValidator.val('txtPersonOrBank');
    var amount = ETValidator.val('txtLoanAmount');
    var dueDate = ETValidator.val('txtLoanDueDate');

    if (ETValidator.isEmpty(person)) {
        ETValidator.markError('txtPersonOrBank');
        ETValidator.showToast('Please enter the Person or Bank name.', 'error');
        var el = ETValidator.get('txtPersonOrBank');
        if (el) el.focus();
        return false;
    }

    if (ETValidator.isEmpty(amount) || !ETValidator.isPositiveNumber(amount)) {
        ETValidator.markError('txtLoanAmount');
        ETValidator.showToast('Please enter a valid loan amount greater than 0.', 'error');
        var el = ETValidator.get('txtLoanAmount');
        if (el) el.focus();
        return false;
    }

    if (ETValidator.isEmpty(dueDate)) {
        ETValidator.markError('txtLoanDueDate');
        ETValidator.showToast('Please select the due date.', 'error');
        var el = ETValidator.get('txtLoanDueDate');
        if (el) el.focus();
        return false;
    }

    return true;
}

